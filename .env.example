ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_DB=neurafix_school_os
POSTGRES_USER=neurafix
POSTGRES_PASSWORD=neurafix_local_password
DATABASE_URL=postgresql+asyncpg://neurafix:neurafix_local_password@postgres:5432/neurafix_school_os

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

MAIN_BACKEND_PORT=8000
AI_SERVICE_PORT=8001
FRONTEND_PORT=3000

JWT_SECRET_KEY=change-this-before-production-32-byte-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
LOGIN_LOCKOUT_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5

AI_SERVICE_INTERNAL_URL=http://ai_service:8001
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
PINECONE_API_KEY=
PINECONE_INDEX=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
